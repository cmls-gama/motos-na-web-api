  "description": "API REST para gerenciamento de motocicletas com autenticação JWT e autorização por perfil",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "mocha ./test/**/*.test.js --timeout=200000 --reporter mochawesome",
    "test:performance:health": "k6 run performance/k6/health-smoke.js"
  },
